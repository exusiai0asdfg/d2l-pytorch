    "# simple rnn\n",
    "import torch\n",
    "from torch import nn\n",
    "def rnn_step(x_t, h_prev, W_xh, W_hh, b_h):\n",
    "    return torch.tanh(x_t@W_xh+h_prev@W_hh+b_h)"
   ]
