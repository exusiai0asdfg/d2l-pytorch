   ],
   "source": [
    "net = nn.Sequential(\n",
    "    nn.LazyLinear(16),\n",
    "    nn.ReLU(),\n",
    "    nn.Linear(16,4)\n",
    ")\n",
    "x = torch.randn(8,10)\n",
    "y = net(x)\n",
    "print(net[0].weight.shape)\n",
    "print(y.shape)"
   ]
